# Outrank Production Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit real credentials, database passwords, or production secrets to Git.

# 1. Database Connection (PostgreSQL 14+)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outrank"

# 2. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Administration Security
# 32+ character random secret used to sign admin session tokens (HMAC-SHA256)
ADMIN_SECRET="replace-with-a-secure-random-32-byte-hex-string-in-production"

# 4. Payment Gateway (Stripe)
# Secret key from your Stripe Dashboard (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=""
# Webhook signing secret from your Stripe Webhooks dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=""
